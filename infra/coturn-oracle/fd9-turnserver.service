[Unit]
Description=coturn TURN relay for fd9
After=network.target

[Service]
ExecStart=/usr/bin/turnserver -c /etc/turnserver.conf --pidfile=/run/turnserver.pid
PIDFile=/run/turnserver.pid
User=turnserver
Group=turnserver
Restart=on-failure
RestartSec=2
# Binding to 443 (alt-tls-listening-port) is a privileged port; coturn
# itself runs unprivileged (User=turnserver above) so it needs this
# capability granted explicitly rather than running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
